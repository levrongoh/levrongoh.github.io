---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import MapView from '../../components/MapView.astro';
import { IMG, formatRange, getEntries, getPhotos, placeName, type Entry } from '../../lib/content';
import { photoPoints, tripPoints } from '../../lib/map';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: entries[i - 1], older: entries[i + 1] },
  }));
}

interface Props {
  entry: Entry;
  newer?: Entry;
  older?: Entry;
}
const { entry, newer, older } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const photos = (await getPhotos()).filter((p) => p.data.trip?.id === entry.id);
const species = [...new Set(photos.map((p) => p.data.species).filter(Boolean))];
const points = [...(await tripPoints([entry])), ...(await photoPoints(photos))];
const og = d.cover ? (await getImage({ src: d.cover, width: 1200, format: 'jpg', quality: IMG.quality })).src : undefined;
---

<Base title={d.title} description={d.summary} image={og}>
  <header class="head">
    {d.cover && <Image src={d.cover} alt="" widths={IMG.large} quality={IMG.quality} sizes="100vw" loading="eager" />}
    <div class="narrow text">
      <p class="eyebrow">{placeName(d)} · {formatRange(d.date, d.endDate)}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
    </div>
  </header>

  <article class="narrow prose">
    <Content />
  </article>

  {
    species.length > 0 && (
      <aside class="narrow seen">
        <p class="eyebrow">Species photographed on this trip</p>
        <p>{species.join(' · ')}</p>
      </aside>
    )
  }

  {
    photos.length > 0 && (
      <section class="wrap section">
        <h2>Photographs from this trip</h2>
        <PhotoGrid photos={photos} />
      </section>
    )
  }

  {
    points.length > 0 && (
      <section class="wrap">
        <MapView points={points} height="380px" />
      </section>
    )
  }

  <nav class="wrap pager" aria-label="More entries">
    {older ? <a href={`/journal/${older.id}/`}>← {older.data.title}</a> : <span />}
    {newer ? <a href={`/journal/${newer.id}/`}>{newer.data.title} →</a> : <span />}
  </nav>
</Base>

<style>
  .head { position: relative; margin-bottom: 3rem; }
  .head img { width: 100%; height: min(70vh, 720px); object-fit: cover; }
  .head:has(img) .text {
    position: absolute;
    inset: auto 0 0 0;
    padding-bottom: 2.5rem;
  }
  .head:has(img)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(17, 17, 14, 0.95));
    pointer-events: none;
  }
  .text { position: relative; z-index: 1; padding-top: 3rem; }
  .lede { font-family: var(--serif); font-size: 1.25rem; color: #d8d2c4; margin: 0; }
  .seen { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .seen p:last-child { margin-top: 0.3rem; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager a { text-decoration: none; color: var(--muted); }
  .pager a:hover { color: var(--accent); }
</style>
