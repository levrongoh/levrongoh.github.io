---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { IMG, formatDate, getPhotos, placeName, type Photo } from '../../lib/content';

export async function getStaticPaths() {
  const photos = await getPhotos();
  return photos.map((photo, i) => ({
    params: { id: photo.id },
    props: { photo, prev: photos[i - 1], next: photos[i + 1], all: photos },
  }));
}

interface Props {
  photo: Photo;
  prev?: Photo;
  next?: Photo;
  all: Photo[];
}
const { photo, prev, next, all } = Astro.props;
const d = photo.data;
const linked = d.trip ? await getEntry(d.trip) : undefined;
// Don't link to a draft entry on the live site (it isn't published yet).
const trip = linked && (import.meta.env.DEV || !linked.data.draft) ? linked : undefined;
const og = await getImage({ src: d.image, width: 1200, format: 'jpg', quality: IMG.quality });
const related = all
  .filter((p) => p.id !== photo.id && ((d.species && p.data.species === d.species) || (d.trip && p.data.trip?.id === d.trip.id)))
  .slice(0, 6);
---

<Base title={d.species ?? d.title} description={d.story ?? `${d.title}, ${placeName(d)}`} image={og.src}>
  <figure class="photo">
    <Image src={d.image} alt={d.alt ?? d.species ?? d.title} widths={IMG.large} quality={IMG.quality} sizes="100vw" loading="eager" />
  </figure>

  <article class="wrap info">
    <div>
      {d.sample && <p class="chip">Sample</p>}
      <p class="eyebrow">{d.category}</p>
      <h1>{d.species ?? d.title}</h1>
      {d.scientific && <p class="sci big">{d.scientific}</p>}
      {d.species && <p class="muted">“{d.title}”</p>}
      {d.story && <p class="story">{d.story}</p>}
    </div>
    <dl>
      <dt>Location</dt><dd>{placeName(d)}</dd>
      <dt>Date</dt><dd>{formatDate(d.date, { day: 'numeric', month: 'long', year: 'numeric' })}</dd>
      {d.camera && (<><dt>Camera</dt><dd>{d.camera}</dd></>)}
      {d.lens && (<><dt>Lens</dt><dd>{d.lens}</dd></>)}
      {d.settings && (<><dt>Settings</dt><dd>{d.settings}</dd></>)}
      {trip && (<><dt>Journal</dt><dd><a href={`/journal/${trip.id}/`}>{trip.data.title} →</a></dd></>)}
    </dl>
  </article>

  <nav class="wrap pager" aria-label="More photos">
    {prev ? <a href={`/photos/${prev.id}/`}>← {prev.data.species ?? prev.data.title}</a> : <span />}
    <a href="/gallery/">All photos</a>
    {next ? <a href={`/photos/${next.id}/`}>{next.data.species ?? next.data.title} →</a> : <span />}
  </nav>

  {
    related.length > 0 && (
      <section class="wrap section">
        <h2>Related</h2>
        <PhotoGrid photos={related} />
      </section>
    )
  }
</Base>

<style>
  .photo { margin: 0; background: #0a0a08; }
  .photo img { width: 100%; max-height: 86vh; object-fit: contain; margin: 0 auto; }
  .info {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem 4rem;
    padding-top: 3rem;
  }
  .big { font-size: 1.2rem; margin: -0.4rem 0 1rem; }
  .story { font-family: var(--serif); font-size: 1.3rem; line-height: 1.5; max-width: 40ch; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem 1.5rem; margin: 0; align-content: start; font-size: 0.95rem; }
  dt { color: var(--muted); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; padding-top: 0.2rem; }
  dd { margin: 0; }
  dd a { color: var(--accent); text-decoration: none; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .pager a { text-decoration: none; color: var(--muted); }
  .pager a:hover { color: var(--accent); }
  @media (max-width: 760px) {
    .info { grid-template-columns: 1fr; }
    .pager { flex-wrap: wrap; }
  }
</style>
