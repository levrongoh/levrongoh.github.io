---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import JournalCard from '../components/JournalCard.astro';
import { IMG, confirmedSpecies, formatDate, getEntries, getPhotos, type Photo } from '../lib/content';
import { Content as Intro, frontmatter as intro } from '../home.md';
import { site } from '../site.config';

const photos = await getPhotos(); // already ordered: featured first, then most stars, then newest
const entries = await getEntries();

const newestFirst = (a: Photo, b: Photo) => b.data.date.valueOf() - a.data.date.valueOf();
const identified = photos.filter(confirmedSpecies);

// Favourites: the photos you've featured or rated 4–5 stars. Until you've
// picked any, show one photo of each species (newest first) for variety.
let favourites = photos.filter((p) => p.data.featured || p.data.rating >= 4);
if (!favourites.length) {
  const seen = new Set<string>();
  favourites = [...identified].sort(newestFirst).filter((p) => {
    const s = confirmedSpecies(p)!;
    return !seen.has(s) && seen.add(s);
  });
}
// The slideshow next to your introduction: your 9 newest featured photos.
// Until you've featured any, it falls back to your top favourites.
const featured = photos.filter((p) => p.data.featured).sort(newestFirst);
const slides = (featured.length ? featured : favourites.length ? favourites : photos).slice(0, 9);
favourites = favourites.filter((p) => !slides.includes(p)).slice(0, 9);

// Recent outings: photos grouped by day and place, newest first.
const outings = Object.values(
  Object.groupBy(
    [...photos].filter((p) => p.data.location !== 'TBC').sort(newestFirst),
    (p) => `${p.data.date.toISOString().slice(0, 10)}|${p.data.location}`,
  ),
)
  .slice(0, 4)
  .map((list) => ({
    date: list![0].data.date,
    location: list![0].data.location,
    country: list![0].data.country,
    species: [...new Set(list!.map(confirmedSpecies).filter(Boolean))],
    // Best-rated frames from the outing first (the list keeps the site order).
    thumbs: photos.filter((p) => list!.includes(p)).slice(0, 5),
    count: list!.length,
  }));
---

<Base>
  <section class="intro wrap">
    <div class="intro-text">
      <p class="eyebrow">Wildlife photography · Singapore</p>
      <h1>{intro.greeting}</h1>
      <div class="intro-body"><Intro /></div>
      <p class="intro-links">
        <a href="/gallery/">See my photos →</a>
        <a href="/journal/">Read the journal →</a>
        <a href="/about/">More about me →</a>
      </p>
      {
        (site.social.email || site.social.instagram) && (
          <p class="intro-contact">
            Say hello:
            {site.social.email && <a href={`mailto:${site.social.email}`}>{site.social.email}</a>}
            {site.social.email && site.social.instagram && <span aria-hidden="true">·</span>}
            {site.social.instagram && (
              <a href={site.social.instagram} rel="me">
                @{site.social.instagram.replace(/\/$/, '').split('/').pop()} on Instagram
              </a>
            )}
          </p>
        )
      }
    </div>
    {
      slides.length > 0 && (
        <figure class="intro-photo" data-carousel aria-roledescription="carousel" aria-label="Recent featured photos">
          <div class="slides">
            {slides.map((p, i) => (
              <a
                class="slide"
                href={`/photos/${p.id}/`}
                aria-hidden={i > 0 ? 'true' : undefined}
                tabindex={i > 0 ? -1 : undefined}
                data-caption={`${p.data.species ?? p.data.title}, ${p.data.location} · ${formatDate(p.data.date, { month: 'short', year: 'numeric' })}`}
              >
                <Image
                  src={p.data.image}
                  alt={p.data.alt ?? p.data.species ?? p.data.title}
                  widths={IMG.grid}
                  quality={IMG.quality}
                  sizes="(max-width: 860px) 100vw, 45vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </a>
            ))}
          </div>
          <figcaption>
            <span class="caption" data-caption-text aria-live="polite">
              {slides[0].data.species ?? slides[0].data.title}, {slides[0].data.location} ·{' '}
              {formatDate(slides[0].data.date, { month: 'short', year: 'numeric' })}
            </span>
            {slides.length > 1 && (
              <span class="nav">
                <button type="button" data-prev aria-label="Previous photo">←</button>
                <span class="dots">
                  {slides.map((_, i) => (
                    <button type="button" data-dot={i} aria-label={`Photo ${i + 1} of ${slides.length}`} aria-current={i === 0 ? 'true' : undefined} />
                  ))}
                </span>
                <button type="button" data-next aria-label="Next photo">→</button>
              </span>
            )}
          </figcaption>
        </figure>
      )
    }
  </section>

  {
    outings.length > 0 && (
      <section class="section wrap">
        <div class="section-head">
          <h2>Recent outings</h2>
          <a class="link-arrow" href="/map/">Where I've been →</a>
        </div>
        <ol class="outings">
          {outings.map((o) => (
            <li>
              <p class="day">
                <strong>{formatDate(o.date, { day: 'numeric' })}</strong>
                <span>{formatDate(o.date, { month: 'short', year: 'numeric' })}</span>
              </p>
              <div class="outing">
                <h3>{o.location}{o.country && o.country !== 'Singapore' && <span class="muted">, {o.country}</span>}</h3>
                <p class="muted">
                  {o.species.length ? o.species.join(' · ') : `${o.count} photo${o.count > 1 ? 's' : ''}`}
                </p>
                <div class="thumbs">
                  {o.thumbs.map((p) => (
                    <a href={`/photos/${p.id}/`} title={p.data.species ?? p.data.title}>
                      <Image src={p.data.image} alt={p.data.species ?? p.data.title} width={240} height={240} fit="cover" quality={IMG.quality} />
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="section wrap">
    <div class="section-head">
      <h2>A few favourites</h2>
      <a class="link-arrow" href="/gallery/">All {photos.length} photos →</a>
    </div>
    <PhotoGrid photos={favourites} />
  </section>

  {
    entries.length > 0 && (
      <section class="section wrap">
        <div class="section-head">
          <h2>Stories from the field</h2>
          <a class="link-arrow" href="/journal/">All entries →</a>
        </div>
        <div class="cards">
          {entries.slice(0, 3).map((e) => (
            <JournalCard entry={e} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-top: clamp(40px, 8vw, 100px);
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .intro h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); margin-bottom: 0.4em; }
  .intro-body { font-size: clamp(1.05rem, 1.6vw, 1.2rem); line-height: 1.75; max-width: 34em; }
  .intro-body :global(p) { margin: 0 0 1em; }
  .intro-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.75rem; margin: 1.75rem 0 0; }
  .intro-links a { text-decoration: none; font-size: 0.95rem; border-bottom: 1px solid var(--line); padding-bottom: 2px; }
  .intro-links a:hover { border-color: var(--accent); }
  .intro-contact { display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem; margin: 1.25rem 0 0; font-size: 0.88rem; color: var(--muted); }
  .intro-contact a { color: var(--text); }
  .intro-contact a:hover { color: var(--accent); }
  .intro-photo { margin: 0; }
  .slides {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 78vh;
    width: 100%;
    overflow: hidden;
    border-radius: 4px;
    background: var(--bg-raised);
    touch-action: pan-y;
  }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.9s ease; pointer-events: none; }
  .slide.active { opacity: 1; pointer-events: auto; }
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .intro-photo figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .caption { font-style: italic; }
  .nav { display: flex; align-items: center; gap: 0.5rem; flex: none; }
  .nav button { background: none; border: 0; color: var(--muted); cursor: pointer; font: inherit; padding: 0.25rem; }
  .nav button:hover { color: var(--text); }
  .dots { display: flex; gap: 6px; }
  .dots button { width: 6px; height: 6px; padding: 0; border-radius: 50%; background: var(--line); }
  .dots button[aria-current='true'] { background: var(--text); }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } }
  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; }
    .slides { aspect-ratio: 4 / 3; }
  }

  .outings { list-style: none; margin: 0; padding: 0; }
  .outings li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem 2rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  .outings li:last-child { border-bottom: 1px solid var(--line); }
  .day { margin: 0; display: flex; flex-direction: column; }
  .day strong { font: 300 2.6rem / 1 var(--serif); }
  .day span { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 0.3rem; }
  .outing h3 { margin: 0 0 0.25rem; font-size: 1.4rem; }
  .outing p { margin: 0 0 1rem; font-size: 0.92rem; }
  .thumbs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .thumbs a { flex: 0 0 auto; }
  .thumbs img { width: 120px; height: 120px; object-fit: cover; border-radius: 3px; transition: filter 0.3s; }
  .thumbs a:hover img { filter: brightness(0.8); }
  @media (max-width: 560px) {
    .outings li { grid-template-columns: 1fr; gap: 0.5rem; }
    .day { flex-direction: row; align-items: baseline; gap: 0.6rem; }
    .day strong { font-size: 1.8rem; }
    .thumbs img { width: 96px; height: 96px; }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 2.5rem 1.75rem;
  }
</style>

<script>
  // Home page slideshow: crossfades every 6 seconds, pauses while you hover or
  // use the controls, and can be swiped on a phone.
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const caption = root.querySelector<HTMLElement>('[data-caption-text]')!;
    let current = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        const on = n === current;
        s.classList.toggle('active', on);
        if (on) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
        s.tabIndex = on ? 0 : -1;
        if (on) s.querySelector('img')?.setAttribute('loading', 'eager');
      });
      dots.forEach((d, n) => d.setAttribute('aria-current', String(n === current)));
      caption.textContent = slides[current].dataset.caption!;
      // Start loading the next photo so it's ready before it fades in.
      slides[(current + 1) % slides.length].querySelector('img')?.setAttribute('loading', 'eager');
    };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stop = () => clearInterval(timer);
    const play = () => {
      stop();
      if (!reduced && slides.length > 1) timer = window.setInterval(() => show(current + 1), 6000);
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => { show(current - 1); play(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { show(current + 1); play(); });
    dots.forEach((d, n) => d.addEventListener('click', () => { show(n); play(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', play);
    root.addEventListener('focusin', stop);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));

    let startX: number | null = null;
    const box = root.querySelector<HTMLElement>('.slides')!;
    box.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') startX = e.clientX; });
    box.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) { show(current + (dx < 0 ? 1 : -1)); play(); }
    });

    show(0);
    play();
  }
</script>
